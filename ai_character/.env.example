# Google Gemini API configuration (Required)
GOOGLE_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Optional prompt override (defaults to Sahakar Sathi prompt)
# AI_CHARACTER_PROMPT="Your custom prompt here"

# Voice & TTS Settings
# edge-tts neural voice fallback (auto-selects hi-IN-MadhurNeural for Hindi and en-IN-PrabhatNeural for English)
EDGE_TTS_VOICE=en-IN-PrabhatNeural

# ElevenLabs Voice API (Optional - automatically falls back to edge-tts and gTTS)
ELEVEN_LABS_API_KEY=your_elevenlabs_api_key_here

# Server settings
PORT=5050
HOST=0.0.0.0
DEBUG=True
SECRET_KEY=change-this-in-production
